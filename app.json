{
  "expo": {
    "name": "OkTreat",
    "slug": "oktreat",
    "scheme": "oktreat",
    "version": "1.0.9",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFC2EB",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oktreat.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes and take pet photos.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload pet photos.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to find nearby pet sitters."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFC2EB"
      },
      "package": "com.oktreat.app",
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCKC_xOrCxAmFIdYpDVTYMDi9CYp_DE5rs"
        }
      }
    },
    "web": {},
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OkTreat to access your camera to scan QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow OkTreat to use your location to find nearby sitters."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#32A6D8"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-localization"
    ]
  }
}
